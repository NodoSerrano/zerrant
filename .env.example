# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosted subpath only. Empty locally. Example: /zerrant-test
# NEXT_PUBLIC_BASE_PATH=
# Distinct session cookie when two apps share a domain. Example: sb-zerrant-test
# NEXT_PUBLIC_SUPABASE_COOKIE_NAME=

# Auth — set to true only when Google OAuth is productized (login/signup CTA)
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
